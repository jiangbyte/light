<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.jiangbyte.github</groupId>
    <artifactId>light</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <description>
        Light：DDD 多模块后端。共享 types/domain/infrastructure，
        Admin 与 Portal 各自 api/trigger/app，可独立部署。
    </description>

    <modules>
        <module>light-types</module>
        <module>light-domain</module>
        <module>light-infrastructure</module>
        <module>light-apis</module>
        <module>light-triggers</module>
        <module>light-apps</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-api-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-api-portal</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-trigger-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-trigger-portal</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-admin-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jiangbyte.github</groupId>
                <artifactId>light-portal-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.24.0</version>
            </plugin>
        </plugins>
    </build>

</project>
